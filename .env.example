# Copy into private .env.local. Never put credentials in NEXT_PUBLIC variables.
# The exact origin must match the browser hostname and port.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Local default: one process per ignored storage/tax-vault directory.
INVOICEFLOW_DATA_DIR=
INVOICEFLOW_DATABASE=
DATABASE_URL=
# Migration role only, never grant its credentials to the application runtime.
INVOICEFLOW_MIGRATION_DATABASE_URL=
# Optional trusted PostgreSQL CA PEM supplied privately; verification always stays enabled.
INVOICEFLOW_DATABASE_CA=
# Hosted private S3 adapter (provider credentials come from the SDK role/provider chain).
INVOICEFLOW_STORAGE=
INVOICEFLOW_S3_BUCKET=
INVOICEFLOW_S3_REGION=
# Unix socket or Windows named pipe, not a public network endpoint.
INVOICEFLOW_CLAMAV_SOCKET=
RESEND_API_KEY=
INVOICEFLOW_EMAIL_FROM=
# Public legal/contact details, required before launch.
INVOICEFLOW_LEGAL_OPERATOR=
INVOICEFLOW_PRIVACY_EMAIL=
# Leave false until deployment evidence and operational/legal checks are complete.
INVOICEFLOW_PRODUCTION_APPROVED=false
# Local backup recovery key is 64 hex characters; keep it separately from backups.
INVOICEFLOW_BACKUP_KEY=
INVOICEFLOW_OPERATOR_APP_STOPPED=false

