# Local account configuration and planned cloud database. No credentials are included.
# PostgreSQL connection URL: configure privately after choosing the database.
DATABASE_URL=
# Optional local auth secret (32+ characters). If blank, development generates an ignored persistent storage/tax-vault/auth-secret. Required explicit secret before any future production release.
BETTER_AUTH_SECRET=
# Exact trusted application origin.
BETTER_AUTH_URL=http://localhost:3000
# Storage and email provider variables will be added with their implementations.
# Optional absolute directory for the local development vault; blank uses storage/tax-vault.
# Never share the same data directory between running application processes.
INVOICEFLOW_DATA_DIR=

